{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unit chart: one square per Brownlow vote for the top ten, coloured by the votes won in that game.",
  "data": {
    "url": "https://raw.githubusercontent.com/alexabrimer/3179/refs/heads/main/data/2026_stats_afltables.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "toNumber(datum['ID'])", "as": "pid"},
    {"calculate": "datum['First.name'] + ' ' + datum['Surname']", "as": "name"},
    {"calculate": "toNumber(datum['Round'])", "as": "round"},
    {"calculate": "isValid(toNumber(datum['Brownlow.Votes'])) ? toNumber(datum['Brownlow.Votes']) : 0", "as": "votes"},

    {"filter": "isValid(datum.round) && datum.round >= 1 && datum.round <= 25"},

    {
      "joinaggregate": [{"op": "sum", "field": "votes", "as": "total_votes"}],
      "groupby": ["pid"]
    },
    {"calculate": "datum.total_votes + datum.pid / 10000000", "as": "vote_score"},
    {
      "window": [{"op": "dense_rank", "as": "vote_rank"}],
      "sort": [{"field": "vote_score", "order": "descending"}]
    },
    {"filter": "datum.vote_rank <= 10 && datum.votes > 0"},

    {"calculate": "datum.votes == 3 ? [1,2,3] : (datum.votes == 2 ? [1,2] : [1])", "as": "unit"},
    {"flatten": ["unit"]},
    {
      "window": [{"op": "row_number", "as": "pos"}],
      "groupby": ["pid"],
      "sort": [
        {"field": "votes", "order": "descending"},
        {"field": "round", "order": "ascending"},
        {"field": "unit", "order": "ascending"}
      ]
    },
    {"calculate": "datum.pos - 1", "as": "x0"}
  ],
  "width": "container",
  "height": {"step": 34},
  "padding": {"left": 10, "right": 40, "top": 10, "bottom": 10},
  "encoding": {
    "y": {
      "field": "name",
      "type": "nominal",
      "title": null,
      "sort": {"field": "total_votes", "op": "max", "order": "descending"},
      "axis": {"domain": false, "ticks": false, "labelPadding": 8, "labelFontSize": 12}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "height": {"band": 0.8}, "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Brownlow votes (one square = one vote)",
          "scale": {"domain": [0, 50]},
          "axis": {"values": [0, 10, 20, 30, 40, 50], "grid": false, "tickMinStep": 10}
        },
        "x2": {"field": "pos"},
        "color": {
          "field": "votes",
          "type": "ordinal",
          "title": "Votes from a single game",
          "scale": {"domain": [3, 2, 1], "range": ["#084594", "#4292c6", "#9ecae1"]},
          "legend": {
            "orient": "top",
            "titleLimit": 300,
            "labelLimit": 300,
            "labelExpr": "datum.value == 3 ? '3 votes (best on ground)' : (datum.value == 2 ? '2 votes' : '1 vote')"
          }
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Player"},
          {"field": "round", "type": "quantitative", "title": "Round"},
          {"field": "votes", "type": "quantitative", "title": "Votes from this game"},
          {"field": "total_votes", "type": "quantitative", "title": "Season total"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.pos == datum.total_votes"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontWeight": "bold", "fontSize": 12},
      "encoding": {
        "x": {"field": "pos", "type": "quantitative", "scale": {"domain": [0, 50]}},
        "text": {"field": "total_votes", "type": "quantitative"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}