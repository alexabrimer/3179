{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: each player's rank by running total of disposals.",
  "data": {
    "url": "https://raw.githubusercontent.com/alexabrimer/3179/refs/heads/main/data/stats_brownlow_top_ten.csv",
    "format": {"type": "csv", "parse": {"disposals": "number"}}
  },
  "transform": [
    {"calculate": "datum['player.surname']", "as": "player"},
    {"calculate": "toNumber(datum['round.roundNumber'])", "as": "round"},
    {
      "aggregate": [{"op": "sum", "field": "disposals", "as": "total"}],
      "groupby": ["player", "round"]
    },
    {
      "impute": "total",
      "key": "round",
      "groupby": ["player"],
      "value": 0
    },
    {
      "window": [{"op": "sum", "field": "total", "as": "running_total"}],
      "frame": [null, 0],
      "groupby": ["player"],
      "sort": [{"field": "round", "order": "ascending"}]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "groupby": ["round"],
      "sort": [{"field": "running_total", "order": "descending"}]
    },
    {
      "joinaggregate": [{"op": "max", "field": "round", "as": "last_round"}]
    }
  ],
  "width": 500,
  "height": 350,
  "padding": {"left": 10, "right": 80, "top": 10, "bottom": 10},
  "encoding": {
    "x": {
      "field": "round",
      "type": "ordinal",
      "title": "Round",
      "axis": {"labelAngle": 0, "grid": false}
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank (running total of disposals)",
      "scale": {"reverse": true, "zero": false, "padding": 10},
      "axis": {"tickMinStep": 1, "format": "d", "grid": true}
    },
    "color": {"field": "player", "type": "nominal", "legend": null}
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 3, "interpolate": "monotone"},
      "encoding": {"detail": {"field": "player", "type": "nominal"}}
    },
    {
      "mark": {"type": "circle", "size": 120, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "player", "type": "nominal", "title": "Player"},
          {"field": "round", "type": "ordinal", "title": "Round"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {"field": "total", "type": "quantitative", "title": "Disposals (round)"},
          {"field": "running_total", "type": "quantitative", "title": "Disposals (running total)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.round == datum.last_round"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontWeight": "bold"},
      "encoding": {"text": {"field": "player", "type": "nominal"}}
    }
  ],
  "config": {"view": {"stroke": null}}
}