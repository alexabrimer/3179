{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jitter plot using faceted columns instead of xOffset (works on Vega-Lite 4 and 5).",
  "data": {
    "url": "https://raw.githubusercontent.com/alexabrimer/3179/refs/heads/main/data/stats_brownlow_top_ten.csv",
    "format": {"type": "csv", "parse": {"disposals": "number"}}
  },
  "transform": [
    {"calculate": "datum['player.surname']", "as": "player"},
    {"calculate": "random()", "as": "jitter"}
  ],
  "width": 60,
  "height": 300,
  "mark": {"type": "point", "filled": true, "size": 40, "opacity": 0.6},
  "encoding": {
    "column": {
      "field": "player",
      "type": "nominal",
      "title": "Player",
      "header": {"labelOrient": "bottom", "titleOrient": "bottom", "labelAngle": 0}
    },
    "x": {
      "field": "jitter",
      "type": "quantitative",
      "axis": null,
      "scale": {"domain": [-0.3, 1.3]}
    },
    "y": {
      "field": "disposalEfficiency",
      "type": "quantitative",
      "title": "Disposal Efficiency (%)"
    },
    "color": {"field": "player", "type": "nominal", "legend": null},
    "tooltip": [
      {"field": "player", "type": "nominal", "title": "Player"},
      {"field": "disposalEfficiency", "type": "quantitative", "title": "Disposal Efficiency (%)"}
    ]
  },
  "spacing": 0,
  "config": {"view": {"stroke": null}}
}