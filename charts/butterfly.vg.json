{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart: the first selected player extends left, the second extends right.",
  "params": [
    {"name": "playerA", "value": "Daicos"},
    {"name": "playerB", "value": "Smith"}
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/alexabrimer/3179/refs/heads/main/data/stats_brownlow_top_ten.csv",
    "format": {
      "type": "csv",
      "parse": {"goals": "number", "kicks": "number", "marks": "number", "disposals": "number", "tackles": "number"}
    }
  },
  "transform": [
    {"calculate": "datum['player.surname']", "as": "player"},
    {"fold": ["goals", "kicks", "marks", "disposals", "tackles"], "as": ["stat", "value"]},
    {
      "aggregate": [{"op": "sum", "field": "value", "as": "total"}],
      "groupby": ["player", "stat"]
    },
    {"joinaggregate": [{"op": "max", "field": "total", "as": "max_total"}]},
    {"filter": "lower(datum.player) === lower(playerA) || lower(datum.player) === lower(playerB)"},
    {"calculate": "lower(datum.player) === lower(playerA) ? 'A' : 'B'", "as": "slot"},
    {"calculate": "datum.slot === 'A' ? -datum.total : datum.total", "as": "signed"},
    {
      "joinaggregate": [{"op": "max", "field": "total", "as": "stat_max"}],
      "groupby": ["stat"]
    },
    {"calculate": "datum.total >= datum.stat_max ? 1 : 0", "as": "higher"}
  ],
  "width": "container",
  "height": {"step": 62},
  "encoding": {
    "y": {
      "field": "stat",
      "type": "nominal",
      "title": null,
      "sort": ["goals", "kicks", "marks", "disposals", "tackles"],
      "axis": {"orient": "left", "domain": false, "ticks": false, "labelPadding": 8}
    },
    "x": {
      "field": "signed",
      "type": "quantitative",
      "title": "Total (the higher number in each pair is in bold)",
      "stack": null,
      "axis": {"labelExpr": "abs(datum.value)", "grid": true}
    },
    "color": {
      "field": "slot",
      "type": "nominal",
      "title": "Player",
      "scale": {"domain": ["A", "B"], "range": ["#4c78a8", "#f58518"]},
      "legend": {"orient": "top", "symbolOpacity": 1, "labelExpr": "datum.value === 'A' ? playerA : playerB"}
    }
  },
  "layer": [
    {
      "description": "Invisible points at +/- the largest value so the zero line stays centred",
      "transform": [
        {"calculate": "[-datum.max_total * 1.15, datum.max_total * 1.15]", "as": "signed"},
        {"flatten": ["signed"]}
      ],
      "mark": {"type": "point", "opacity": 0, "size": 1}
    },
    {
      "mark": {"type": "bar", "height": {"band": 0.7}},
      "encoding": {
        "tooltip": [
          {"field": "player", "type": "nominal", "title": "Player"},
          {"field": "stat", "type": "nominal", "title": "Stat"},
          {"field": "total", "type": "quantitative", "title": "Total"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.signed < 0 && datum.higher == 0"}],
      "mark": {"type": "text", "align": "right", "dx": -4, "fontSize": 11},
      "encoding": {"text": {"field": "total", "type": "quantitative"}}
    },
    {
      "transform": [{"filter": "datum.signed < 0 && datum.higher == 1"}],
      "mark": {"type": "text", "align": "right", "dx": -4, "fontSize": 12, "fontWeight": "bold"},
      "encoding": {"text": {"field": "total", "type": "quantitative"}}
    },
    {
      "transform": [{"filter": "datum.signed >= 0 && datum.higher == 0"}],
      "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 11},
      "encoding": {"text": {"field": "total", "type": "quantitative"}}
    },
    {
      "transform": [{"filter": "datum.signed >= 0 && datum.higher == 1"}],
      "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 12, "fontWeight": "bold"},
      "encoding": {"text": {"field": "total", "type": "quantitative"}}
    },
    {
      "mark": {"type": "rule", "color": "#333333"},
      "encoding": {
        "x": {"datum": 0, "type": "quantitative"},
        "y": {"value": 0},
        "y2": {"value": {"expr": "height"}},
        "color": {"value": "#333333"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}